<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:HybridADManager.Models"
                    xmlns:converters="clr-namespace:HybridADManager.Infrastructure.Converters">

    <!-- Tree Item Template -->
    <HierarchicalDataTemplate DataType="{x:Type models:DirectoryNode}" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" Margin="2,1">
            <Image Source="{Binding NodeType, Converter={StaticResource ObjectTypeToIconConverter}}"
                   Width="16" Height="16" Margin="0,0,4,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                       Foreground="{StaticResource ForegroundBrush}"/>
        </StackPanel>
    </HierarchicalDataTemplate>

    <!-- List Item Template (not used directly; columns in GridView) -->
    <DataTemplate DataType="{x:Type models:DirectoryObject}">
        <Border Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding ObjectType, Converter={StaticResource ObjectTypeToIconConverter}}"
                       Width="16" Height="16" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding ObjectType}" VerticalAlignment="Center"
                           Foreground="{StaticResource ForegroundMutedBrush}"/>
                <TextBlock Grid.Column="3" Text="{Binding Email}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding SyncStatus.DisplayText}" VerticalAlignment="Center"
                           Foreground="{Binding SyncStatus.Status, Converter={StaticResource SyncStatusToBrushConverter}}"
                           FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
