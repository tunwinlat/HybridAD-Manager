<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- High Contrast Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#000000"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="#FFFF00"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectedItemBackground" Color="#0000FF"/>
    <SolidColorBrush x:Key="TreeBackground" Color="#000000"/>
    <SolidColorBrush x:Key="TreeItemHover" Color="#0000FF"/>
    <SolidColorBrush x:Key="TreeItemSelected" Color="#0000FF"/>
    <SolidColorBrush x:Key="SyncInSyncBrush" Color="#00FF00"/>
    <SolidColorBrush x:Key="SyncPendingBrush" Color="#FFFF00"/>
    <SolidColorBrush x:Key="SyncErrorBrush" Color="#FF0000"/>
    <SolidColorBrush x:Key="SyncCloudOnlyBrush" Color="#00FFFF"/>
</ResourceDictionary>
