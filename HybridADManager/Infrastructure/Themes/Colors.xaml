<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#ECECEC"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="MenuHighlightBrush" Color="#CCE4F7"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="PaneBorderBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="TabBorderBrush" Color="#A0A0A0"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ForegroundMutedBrush" Color="#606060"/>
    <SolidColorBrush x:Key="StatusBarForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LinkBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="#A0A0A0"/>

    <!-- Selection -->
    <SolidColorBrush x:Key="SelectionBrush" Color="#CDE8FF"/>
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#99D1FF"/>
    <SolidColorBrush x:Key="SelectedItemBackground" Color="#0078D7"/>
    <SolidColorBrush x:Key="SelectedItemForeground" Color="#FFFFFF"/>

    <!-- Tree -->
    <SolidColorBrush x:Key="TreeBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TreeItemHover" Color="#E5F3FF"/>
    <SolidColorBrush x:Key="TreeItemSelected" Color="#CDE8FF"/>

    <!-- Buttons -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#E1E1E1"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#E5F1FB"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#ADADAD"/>

    <!-- Hybrid Status Colors -->
    <SolidColorBrush x:Key="SyncInSyncBrush" Color="#107C10"/>
    <SolidColorBrush x:Key="SyncPendingBrush" Color="#FFB900"/>
    <SolidColorBrush x:Key="SyncCloudOnlyBrush" Color="#0078D7"/>
    <SolidColorBrush x:Key="SyncErrorBrush" Color="#D83B01"/>

    <!-- Tab Control -->
    <SolidColorBrush x:Key="TabItemSelectedBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabItemBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TabItemHoverBackground" Color="#E5F3FF"/>

    <!-- Alternating Row -->
    <SolidColorBrush x:Key="AlternatingRowBackground" Color="#F8F8F8"/>

    <!-- Separator / Splitter -->
    <SolidColorBrush x:Key="SplitterBackground" Color="#E0E0E0"/>

</ResourceDictionary>
