<Window x:Class="HybridADManager.Views.Dialogs.SavedQueryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HybridADManager.ViewModels"
        Title="Save Query"
        Width="450"
        Height="300"
        MinWidth="400"
        MinHeight="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource ADUCWindowStyle}"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Label Content="Name:" Width="100" VerticalContentAlignment="Center"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Width="300"
                     VerticalContentAlignment="Center"
                     Padding="4,2"
                     AutomationProperties.Name="Query Name"
                     ToolTip="Saved query name"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
            <Label Content="Description:" Width="100" VerticalContentAlignment="Center"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     Width="300"
                     VerticalContentAlignment="Center"
                     Padding="4,2"
                     AutomationProperties.Name="Query Description"
                     ToolTip="Saved query description"/>
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,4"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
            <Label Content="Name filter:" Width="100" VerticalContentAlignment="Center"/>
            <TextBox Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"
                     Width="300"
                     VerticalContentAlignment="Center"
                     Padding="4,2"
                     AutomationProperties.Name="Name Filter"
                     ToolTip="Filter by name"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
            <Label Content="Email filter:" Width="100" VerticalContentAlignment="Center"/>
            <TextBox Text="{Binding FilterEmail, UpdateSourceTrigger=PropertyChanged}"
                     Width="300"
                     VerticalContentAlignment="Center"
                     Padding="4,2"
                     AutomationProperties.Name="Email Filter"
                     ToolTip="Filter by email"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,4">
            <Label Content="Description filter:" Width="100" VerticalContentAlignment="Center"/>
            <TextBox Text="{Binding FilterDescription, UpdateSourceTrigger=PropertyChanged}"
                     Width="300"
                     VerticalContentAlignment="Center"
                     Padding="4,2"
                     AutomationProperties.Name="Description Filter"
                     ToolTip="Filter by description"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,4">
            <Label Content="Phone filter:" Width="100" VerticalContentAlignment="Center"/>
            <TextBox Text="{Binding FilterPhone, UpdateSourceTrigger=PropertyChanged}"
                     Width="300"
                     VerticalContentAlignment="Center"
                     Padding="4,2"
                     AutomationProperties.Name="Phone Filter"
                     ToolTip="Filter by phone"/>
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,8,0,0">
            <Button Content="Save"
                    Width="75" Height="23"
                    Margin="0,0,6,0"
                    IsDefault="True"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.Name="Save Query"
                    ToolTip="Save query"/>
            <Button Content="Cancel"
                    Width="75" Height="23"
                    IsCancel="True"
                    AutomationProperties.Name="Cancel"
                    ToolTip="Cancel"/>
        </StackPanel>
    </Grid>
</Window>
