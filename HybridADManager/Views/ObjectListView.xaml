<UserControl x:Class="HybridADManager.Views.ObjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HybridADManager.ViewModels"
             xmlns:models="clr-namespace:HybridADManager.Models"
             xmlns:converters="clr-namespace:HybridADManager.Infrastructure.Converters">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Quick Search -->
        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="SearchBox"
                         Width="200"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Padding="4,2"/>
            </StackPanel>
        </Border>

        <!-- Object List -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding FilteredObjects}"
                  SelectedItem="{Binding SelectedObject}"
                  AlternationCount="2"
                  MouseDoubleClick="ListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="220">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:DirectoryObject}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ObjectType, StringFormat='[{0}] '}"
                                               Foreground="{StaticResource ForegroundMutedBrush}"
                                               FontSize="10"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="80"
                                    DisplayMemberBinding="{Binding ObjectType}"/>
                    <GridViewColumn Header="Description" Width="180"
                                    DisplayMemberBinding="{Binding Description}"/>
                    <GridViewColumn Header="Email / UPN" Width="220"
                                    DisplayMemberBinding="{Binding Email}"/>
                    <GridViewColumn Header="Sync Status" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:DirectoryObject}">
                                <TextBlock Text="{Binding SyncStatus.DisplayText}"
                                           Foreground="{Binding SyncStatus.Status, Converter={StaticResource SyncStatusToBrushConverter}}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Enabled" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:DirectoryObject}">
                                <TextBlock Text="{Binding IsEnabled}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Properties" Command="{Binding OpenPropertiesCommand}"/>
                    <Separator/>
                    <MenuItem Header="Reset Password..."/>
                    <MenuItem Header="Disable Account"/>
                    <MenuItem Header="Move..."/>
                    <Separator/>
                    <MenuItem Header="Delete"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
</UserControl>
