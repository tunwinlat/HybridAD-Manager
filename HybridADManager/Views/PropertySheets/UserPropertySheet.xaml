<Window x:Class="HybridADManager.Views.PropertySheets.UserPropertySheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HybridADManager.ViewModels"
        xmlns:tabs="clr-namespace:HybridADManager.Views.PropertySheets.Tabs"
        Title="User Properties"
        Width="580" Height="560"
        MinWidth="500" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource ADUCWindowStyle}"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.DataContext>
        <vm:UserPropertySheetViewModel/>
    </Window.DataContext>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Style="{StaticResource PropertySheetTabControl}"
                    TabItemContainerStyle="{StaticResource PropertySheetTabItem}">
            <TabItem Header="General">
                <tabs:GeneralTab DataContext="{Binding GeneralTab}"/>
            </TabItem>
            <TabItem Header="Address">
                <tabs:AddressTab DataContext="{Binding AddressTab}"/>
            </TabItem>
            <TabItem Header="Account">
                <tabs:AccountTab DataContext="{Binding AccountTab}"/>
            </TabItem>
            <TabItem Header="Profile">
                <Grid>
                    <TextBlock Text="Profile settings will be implemented in a later phase."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundMutedBrush}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Telephones">
                <Grid>
                    <TextBlock Text="Telephone settings will be implemented in a later phase."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundMutedBrush}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Organization">
                <tabs:OrganizationTab DataContext="{Binding OrganizationTab}"/>
            </TabItem>
            <TabItem Header="Member Of">
                <tabs:MemberOfTab DataContext="{Binding MemberOfTab}"/>
            </TabItem>
            <TabItem Header="Dial-in">
                <Grid>
                    <TextBlock Text="Dial-in settings will be implemented in a later phase."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundMutedBrush}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Environment">
                <Grid>
                    <TextBlock Text="Environment settings will be implemented in a later phase."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundMutedBrush}"/>
                </Grid>
            </TabItem>

            <!-- Hybrid / Cloud Tabs -->
            <TabItem Header="Hybrid Status">
                <tabs:HybridStatusTab DataContext="{Binding HybridStatusTab}"/>
            </TabItem>
            <TabItem Header="Licenses">
                <Grid>
                    <TextBlock Text="License management will be implemented in Phase 4."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundMutedBrush}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Mailbox">
                <Grid>
                    <TextBlock Text="Mailbox management will be implemented in Phase 4."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundMutedBrush}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Email Addresses">
                <Grid>
                    <TextBlock Text="Email address management will be implemented in Phase 4."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ForegroundMutedBrush}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Button Row -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="OK"
                    Width="75" Height="23"
                    Margin="0,0,6,0"
                    IsDefault="True"/>
            <Button Content="Cancel"
                    Width="75" Height="23"
                    Margin="0,0,6,0"
                    IsCancel="True"/>
            <Button Content="Apply"
                    Width="75" Height="23"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
