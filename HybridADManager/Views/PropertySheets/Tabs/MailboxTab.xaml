<UserControl x:Class="HybridADManager.Views.PropertySheets.Tabs.MailboxTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Mailbox Settings"
                       FontSize="14" FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <!-- Primary SMTP Address -->
            <Label Grid.Row="1" Grid.Column="0"
                   Content="Primary SMTP address:"
                   VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1"
                     Text="{Binding PrimarySmtp}"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     Padding="4,2"
                     Background="{StaticResource ToolbarBackgroundBrush}"/>

            <Separator Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                       Margin="0,12"/>

            <!-- Automatic Replies -->
            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Automatic Replies (Out of Office)"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="4,0,0,8">
                <RadioButton Content="Do not send automatic replies"
                             IsChecked="{Binding AutoReplyDisabled}"
                             GroupName="AutoReplyGroup"
                             Margin="0,2"/>
                <RadioButton Content="Send automatic replies"
                             IsChecked="{Binding AutoReplyEnabled}"
                             GroupName="AutoReplyGroup"
                             Margin="0,2"/>
                <RadioButton Content="Send automatic replies for a specific period"
                             IsChecked="{Binding AutoReplyScheduled}"
                             GroupName="AutoReplyGroup"
                             Margin="0,2"/>
            </StackPanel>

            <!-- Internal Reply Message -->
            <Label Grid.Row="5" Grid.Column="0"
                   Content="Internal reply:"
                   VerticalAlignment="Top"
                   Margin="0,4,0,0"/>
            <TextBox Grid.Row="5" Grid.Column="1"
                     Text="{Binding AutoReplyInternalMessage, Mode=TwoWay}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Height="80"
                     Padding="4,2"
                     Margin="0,2"/>

            <!-- External Reply Message -->
            <Label Grid.Row="6" Grid.Column="0"
                   Content="External reply:"
                   VerticalAlignment="Top"
                   Margin="0,4,0,0"/>
            <TextBox Grid.Row="6" Grid.Column="1"
                     Text="{Binding AutoReplyExternalMessage, Mode=TwoWay}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Height="80"
                     Padding="4,2"
                     Margin="0,2"/>

            <!-- External Audience -->
            <Label Grid.Row="7" Grid.Column="0"
                   Content="External audience:"
                   VerticalAlignment="Center"/>
            <ComboBox Grid.Row="7" Grid.Column="1"
                      SelectedValue="{Binding ExternalAudience, Mode=TwoWay}"
                      SelectedValuePath="Tag"
                      VerticalContentAlignment="Center"
                      Padding="4,2"
                      Margin="0,2">
                <ComboBoxItem Content="All external senders" Tag="all"/>
                <ComboBoxItem Content="Contacts only" Tag="contactsOnly"/>
                <ComboBoxItem Content="None" Tag="none"/>
            </ComboBox>

            <Separator Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                       Margin="0,12"/>

            <!-- Mail Forwarding -->
            <TextBlock Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Mail Forwarding"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <Label Grid.Row="10" Grid.Column="0"
                   Content="Forwarding address:"
                   VerticalAlignment="Center"/>
            <TextBox Grid.Row="10" Grid.Column="1"
                     Text="{Binding ForwardingAddress, Mode=TwoWay}"
                     VerticalContentAlignment="Center"
                     Padding="4,2"
                     Margin="0,2"/>

            <CheckBox Grid.Row="11" Grid.Column="1"
                      Content="Keep a copy in this mailbox"
                      Margin="0,4,0,0"/>

            <Separator Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                       Margin="0,12"/>

            <!-- Address List Visibility -->
            <TextBlock Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Address List Visibility"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <CheckBox Grid.Row="14" Grid.Column="1"
                      Content="Hide from address lists"
                      IsChecked="{Binding HideFromAddressLists, Mode=TwoWay}"
                      Margin="0,4,0,0"/>

            <Separator Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2"
                       Margin="0,12"/>

            <!-- Error Message -->
            <TextBlock Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource SyncErrorBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>

            <!-- Loading Indicator -->
            <TextBlock Grid.Row="17" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="Loading..."
                       Foreground="{StaticResource ForegroundMutedBrush}"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- Save Button -->
            <Button Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="2"
                    Content="Save Mailbox Settings"
                    HorizontalAlignment="Left"
                    Padding="16,6"
                    Margin="0,12,0,0"
                    Command="{Binding SaveMailboxSettingsCommand}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
