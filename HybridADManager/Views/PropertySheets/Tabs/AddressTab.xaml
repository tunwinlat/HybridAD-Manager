<UserControl x:Class="HybridADManager.Views.PropertySheets.Tabs.AddressTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Address Tab">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Street:"
               VerticalAlignment="Top" Margin="0,4,0,0"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                 Height="60"
                 Text="{Binding User.StreetAddress, Mode=TwoWay}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Padding="3,2"
                 Margin="0,2"
                 AutomationProperties.Name="Street Address"
                 ToolTip="Street address"/>

        <Label Grid.Row="1" Grid.Column="0" Content="P.O. Box:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"
                 AutomationProperties.Name="P.O. Box"
                 ToolTip="Post office box"/>

        <Label Grid.Row="2" Grid.Column="0" Content="City:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 Text="{Binding User.City, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"
                 AutomationProperties.Name="City"
                 ToolTip="City"/>

        <Label Grid.Row="2" Grid.Column="2" Content="State / Province:"
               VerticalAlignment="Center"
               Margin="12,0,0,0"/>
        <TextBox Grid.Row="2" Grid.Column="3"
                 Text="{Binding User.State, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"
                 AutomationProperties.Name="State / Province"
                 ToolTip="State or province"/>

        <Label Grid.Row="3" Grid.Column="0" Content="ZIP / Postal Code:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1"
                 Text="{Binding User.PostalCode, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"
                 AutomationProperties.Name="ZIP / Postal Code"
                 ToolTip="ZIP or postal code"/>

        <Label Grid.Row="3" Grid.Column="2" Content="Country / Region:"
               VerticalAlignment="Center"
               Margin="12,0,0,0"/>
        <ComboBox Grid.Row="3" Grid.Column="3"
                  Text="{Binding User.Country, Mode=TwoWay}"
                  VerticalContentAlignment="Center"
                  Margin="0,2"
                  AutomationProperties.Name="Country / Region"
                  ToolTip="Country or region"/>
    </Grid>
</UserControl>
