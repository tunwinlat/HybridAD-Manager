<UserControl x:Class="HybridADManager.Views.PropertySheets.Tabs.GeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Name Section -->
        <Label Grid.Row="0" Grid.Column="0" Content="First name:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1"
                 Text="{Binding User.FirstName, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"/>

        <Label Grid.Row="0" Grid.Column="2" Content="Initials:"
               VerticalAlignment="Center"
               Margin="12,0,0,0"/>
        <TextBox Grid.Row="0" Grid.Column="3"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Last name:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 Text="{Binding User.LastName, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Display name:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                 Text="{Binding User.DisplayName, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"/>

        <Separator Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                   Margin="0,8"/>

        <!-- Description -->
        <Label Grid.Row="4" Grid.Column="0" Content="Description:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                 Text="{Binding User.Description, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Office:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1"
                 Text="{Binding User.Office, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"/>

        <Label Grid.Row="5" Grid.Column="2" Content="Telephone:"
               VerticalAlignment="Center"
               Margin="12,0,0,0"/>
        <TextBox Grid.Row="5" Grid.Column="3"
                 Text="{Binding User.Telephone, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"/>

        <Separator Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4"
                   Margin="0,8"/>

        <!-- Email -->
        <Label Grid.Row="7" Grid.Column="0" Content="E-mail:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3"
                 Text="{Binding User.Email, Mode=TwoWay}"
                 VerticalContentAlignment="Center"
                 Padding="3,2"
                 Margin="0,2"/>

        <!-- Hybrid Status Badge -->
        <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4"
                     Orientation="Horizontal"
                     VerticalAlignment="Bottom"
                     Margin="0,8,0,0">
            <TextBlock Text="Hybrid Status:"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Border Background="{Binding User.SyncStatus.Status, Converter={StaticResource SyncStatusToBrushConverter}}"
                    CornerRadius="3"
                    Padding="6,2"
                    Margin="6,0,0,0">
                <TextBlock Text="{Binding User.SyncStatus.DisplayText}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="11"/>
            </Border>
            <TextBlock Text="{Binding User.EntraObjectId, StringFormat='Object ID: {0}'}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Foreground="{StaticResource ForegroundMutedBrush}"
                       FontSize="11"/>
        </StackPanel>
    </Grid>
</UserControl>
