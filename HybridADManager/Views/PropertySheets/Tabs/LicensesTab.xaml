<UserControl x:Class="HybridADManager.Views.PropertySheets.Tabs.LicensesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading -->
        <TextBlock Grid.Row="0"
                   Text="Loading licenses..."
                   Foreground="{StaticResource ForegroundMutedBrush}"
                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                   Margin="0,0,0,6"/>

        <!-- Error -->
        <TextBlock Grid.Row="1"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource SyncErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- No licenses -->
        <TextBlock Grid.Row="2"
                   Text="No licenses available or user not found in Entra ID."
                   Foreground="{StaticResource ForegroundMutedBrush}"
                   Visibility="{Binding HasLicenses, Converter={StaticResource InverseBoolConverter}}"
                   Margin="0,0,0,6"/>

        <!-- Licenses List -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Background="{StaticResource PaneBackgroundBrush}"
                Visibility="{Binding HasLicenses, Converter={StaticResource BoolToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Licenses}"
                              AlternationCount="2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- License Header -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Content="{Binding DisplayName}"
                                                  IsChecked="{Binding IsAssigned, Mode=TwoWay}"
                                                  Command="{Binding DataContext.ToggleLicenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  VerticalAlignment="Center"
                                                  FontWeight="SemiBold"/>

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource ForegroundMutedBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                    <Binding Path="ConsumedUnits"/>
                                                    <Binding Path="TotalUnits"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Service Plans Expander -->
                                    <Expander Grid.Row="1"
                                              Header="Service plans"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Margin="24,4,0,0"
                                              Foreground="{StaticResource ForegroundBrush}">
                                        <ItemsControl ItemsSource="{Binding ServicePlans}"
                                                      Margin="4,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,2">
                                                        <Ellipse Width="8"
                                                                 Height="8"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource ForegroundMutedBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ProvisioningStatus}" Value="Success">
                                                                            <Setter Property="Fill" Value="{StaticResource SyncInSyncBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ProvisioningStatus}" Value="PendingProvisioning">
                                                                            <Setter Property="Fill" Value="{StaticResource SyncPendingBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ProvisioningStatus}" Value="PendingInput">
                                                                            <Setter Property="Fill" Value="{StaticResource SyncPendingBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ProvisioningStatus}" Value="Disabled">
                                                                            <Setter Property="Fill" Value="{StaticResource SyncErrorBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <CheckBox Content="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsEnabled}"
                                                                  IsEnabled="False"
                                                                  VerticalAlignment="Center"
                                                                  FontSize="11"
                                                                  Foreground="{StaticResource ForegroundBrush}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Refresh Button -->
        <Button Grid.Row="4"
                Content="Refresh"
                Command="{Binding RefreshLicensesCommand}"
                HorizontalAlignment="Right"
                Width="75"
                Height="23"
                Margin="0,8,0,0"/>
    </Grid>
</UserControl>
