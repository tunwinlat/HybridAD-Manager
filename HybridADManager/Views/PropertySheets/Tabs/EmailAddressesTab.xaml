<UserControl x:Class="HybridADManager.Views.PropertySheets.Tabs.EmailAddressesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Email Addresses Tab">

    <Grid Margin="12"
          Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Email addresses:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"
                   Foreground="{StaticResource ForegroundBrush}"/>

        <!-- Address List -->
        <Border Grid.Row="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <ListView ItemsSource="{Binding Addresses}"
                      SelectedItem="{Binding SelectedAddress}"
                      AlternationCount="2"
                      AutomationProperties.Name="Email Addresses"
                      ToolTip="List of email addresses">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Type" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}"
                                               Foreground="{StaticResource ForegroundBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Address" Width="*">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Address}"
                                               Foreground="{StaticResource ForegroundBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Primary" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="✓"
                                               Foreground="{StaticResource ForegroundBrush}"
                                               Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Add New Address -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Width="80"
                      Margin="0,0,6,0"
                      VerticalContentAlignment="Center"
                      SelectedValue="{Binding SelectedAddressType}"
                      SelectedValuePath="Content"
                      BorderBrush="{StaticResource BorderBrush}"
                      AutomationProperties.Name="Address Type"
                      ToolTip="Email address type">
                <ComboBoxItem Content="SMTP"/>
                <ComboBoxItem Content="smtp"/>
                <ComboBoxItem Content="SIP"/>
                <ComboBoxItem Content="X500"/>
            </ComboBox>

            <TextBox Grid.Column="1"
                     Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Padding="3,2"
                     Margin="0,0,6,0"
                     BorderBrush="{StaticResource BorderBrush}"
                     AutomationProperties.Name="New Email Address"
                     ToolTip="Enter a new email address"/>

            <Button Grid.Column="2"
                    Content="Add"
                    Width="75" Height="23"
                    Command="{Binding AddAddressCommand}"
                    Margin="0,0,6,0"
                    AutomationProperties.Name="Add Email Address"
                    ToolTip="Add the email address"/>

            <TextBlock Grid.Column="3"
                       Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource SyncErrorBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="250">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0">
            <Button Content="Remove"
                    Width="90" Height="23"
                    Command="{Binding RemoveAddressCommand}"
                    Margin="0,0,6,0"
                    AutomationProperties.Name="Remove Email Address"
                    ToolTip="Remove selected email address"/>
            <Button Content="Set as Primary"
                    Width="90" Height="23"
                    Command="{Binding SetPrimaryCommand}"
                    Margin="0,0,6,0"
                    AutomationProperties.Name="Set Primary Email"
                    ToolTip="Set selected as primary SMTP"/>
            <Button Content="Save Changes"
                    Width="90" Height="23"
                    Command="{Binding SaveAddressesCommand}"
                    IsEnabled="{Binding HasChanges}"
                    AutomationProperties.Name="Save Email Changes"
                    ToolTip="Save email address changes"/>
        </StackPanel>

        <!-- Loading / Status -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,8,0,0">
            <TextBlock Text="Saving..."
                       Foreground="{StaticResource ForegroundMutedBrush}"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
