<Application x:Class="HybridADManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Infrastructure/Themes/Colors.xaml"/>
                <ResourceDictionary Source="Infrastructure/Themes/Converters.xaml"/>
                <ResourceDictionary Source="Infrastructure/Themes/ADUCStyles.xaml"/>
                <ResourceDictionary Source="Infrastructure/Themes/DataTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
