<Window x:Class="HybridADManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HybridADManager.ViewModels"
        xmlns:views="clr-namespace:HybridADManager.Views"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ADUCWindowStyle}">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F3" Command="{Binding FindCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewUserCommand}"/>
        <KeyBinding Key="G" Modifiers="Control" Command="{Binding NewGroupCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Add _Domain..." AutomationProperties.Name="Add Domain"/>
                <MenuItem Header="Change _Domain..." AutomationProperties.Name="Change Domain"/>
                <Separator/>
                <MenuItem Header="Export to _CSV..." Command="{Binding ExportCommand}" InputGestureText="Ctrl+E" AutomationProperties.Name="Export to CSV"/>
                <Separator/>
                <MenuItem Header="E_xit" AutomationProperties.Name="Exit"/>
            </MenuItem>
            <MenuItem Header="_Action">
                <MenuItem Header="_New">
                    <MenuItem Header="_User" Command="{Binding NewUserCommand}" InputGestureText="Ctrl+N" AutomationProperties.Name="New User"/>
                    <MenuItem Header="_Group" Command="{Binding NewGroupCommand}" InputGestureText="Ctrl+G" AutomationProperties.Name="New Group"/>
                    <MenuItem Header="_Organizational Unit" AutomationProperties.Name="New Organizational Unit"/>
                    <MenuItem Header="_Computer" AutomationProperties.Name="New Computer"/>
                    <MenuItem Header="_Contact" AutomationProperties.Name="New Contact"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Find..." Command="{Binding FindCommand}" InputGestureText="F3" AutomationProperties.Name="Find"/>
                <Separator/>
                <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" InputGestureText="Del" AutomationProperties.Name="Delete"/>
                <MenuItem Header="_Rename" AutomationProperties.Name="Rename"/>
                <MenuItem Header="_Move..." AutomationProperties.Name="Move"/>
                <Separator/>
                <MenuItem Header="_Refresh" Command="{Binding RefreshCommand}" InputGestureText="F5" AutomationProperties.Name="Refresh"/>
                <Separator/>
                <MenuItem Header="_Properties" Command="{Binding PropertiesCommand}" AutomationProperties.Name="Properties"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Customize Columns..." AutomationProperties.Name="Customize Columns"/>
                <MenuItem Header="_Filter Options..." AutomationProperties.Name="Filter Options"/>
                <Separator/>
                <MenuItem Header="_Advanced Features" IsCheckable="True" AutomationProperties.Name="Advanced Features"/>
                <Separator/>
                <MenuItem Header="_High Contrast" IsCheckable="True" Checked="HighContrast_Checked" Unchecked="HighContrast_Unchecked" AutomationProperties.Name="High Contrast"/>
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem Header="_New Window" AutomationProperties.Name="New Window"/>
                <MenuItem Header="_Cascade" AutomationProperties.Name="Cascade"/>
                <MenuItem Header="Tile _Horizontally" AutomationProperties.Name="Tile Horizontally"/>
                <MenuItem Header="Tile _Vertically" AutomationProperties.Name="Tile Vertically"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help Topics" AutomationProperties.Name="Help Topics"/>
                <Separator/>
                <MenuItem Header="_About HybridAD-Manager" AutomationProperties.Name="About HybridAD Manager"/>
            </MenuItem>
        </Menu>

        <!-- ToolBar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource ToolbarBackgroundBrush}">
        <ToolBar>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding NewUserCommand}"
                    ToolTip="New User (Ctrl+N)"
                    AutomationProperties.Name="New User">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="New"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding FindCommand}"
                    ToolTip="Find (F3)"
                    AutomationProperties.Name="Find">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Find"/>
                </StackPanel>
            </Button>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding DeleteCommand}"
                    ToolTip="Delete (Del)"
                    AutomationProperties.Name="Delete">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Delete"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Refresh (F5)"
                    AutomationProperties.Name="Refresh">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding PropertiesCommand}"
                    ToolTip="Properties"
                    AutomationProperties.Name="Properties">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Properties"/>
                </StackPanel>
            </Button>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding ExportCommand}"
                    ToolTip="Export to CSV (Ctrl+E)"
                    AutomationProperties.Name="Export to CSV">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Export"/>
                </StackPanel>
            </Button>
        </ToolBar>
        <ToolBar Band="0" BandIndex="1">
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding ToggleAuthenticationCommand}"
                    ToolTip="Sign in to Microsoft Entra ID"
                    AutomationProperties.Name="Sign In">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AuthButtonText}"/>
                </StackPanel>
            </Button>
        </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}"/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ListViewModel.TotalCount, StringFormat='{}{0} objects'}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding DomainName}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding LoggedInUser}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content: Tree + List Splitter -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="450"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Directory Tree -->
            <Border Grid.Column="0"
                    Background="{StaticResource PaneBackgroundBrush}"
                    BorderBrush="{StaticResource PaneBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                              Text="Directory"
                              FontWeight="SemiBold"
                              Padding="8,4"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,0,0,1"/>
                    <views:DirectoryTreeView DataContext="{Binding TreeViewModel}"/>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Width="4"
                          Background="{StaticResource SplitterBackground}"
                          ShowsPreview="False"/>

            <!-- Right Pane: Object List -->
            <Border Grid.Column="2"
                    Background="{StaticResource PaneBackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                              Text="Object List"
                              FontWeight="SemiBold"
                              Padding="8,4"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,0,0,1"/>
                    <views:ObjectListView DataContext="{Binding ListViewModel}"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Border Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="⏳"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Foreground="White"/>
                <TextBlock Text="{Binding BusyMessage}"
                          FontSize="14"
                          Foreground="White"
                          Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
