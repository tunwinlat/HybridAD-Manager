<Window x:Class="HybridADManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HybridADManager.ViewModels"
        xmlns:views="clr-namespace:HybridADManager.Views"
        Title="{Binding WindowTitle}"
        Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ADUCWindowStyle}">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Add _Domain..."/>
                <MenuItem Header="Change _Domain..."/>
                <Separator/>
                <MenuItem Header="Export to _CSV..." Command="{Binding ExportCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit"/>
            </MenuItem>
            <MenuItem Header="_Action">
                <MenuItem Header="_New">
                    <MenuItem Header="_User" Command="{Binding NewUserCommand}"/>
                    <MenuItem Header="_Group" Command="{Binding NewGroupCommand}"/>
                    <MenuItem Header="_Organizational Unit"/>
                    <MenuItem Header="_Computer"/>
                    <MenuItem Header="_Contact"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Find..." Command="{Binding FindCommand}" InputGestureText="Ctrl+F"/>
                <Separator/>
                <MenuItem Header="_Delete" Command="{Binding DeleteCommand}"/>
                <MenuItem Header="_Rename"/>
                <MenuItem Header="_Move..."/>
                <Separator/>
                <MenuItem Header="_Properties" Command="{Binding PropertiesCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Customize Columns..."/>
                <MenuItem Header="_Filter Options..."/>
                <Separator/>
                <MenuItem Header="_Advanced Features" IsCheckable="True"/>
            </MenuItem>
            <MenuItem Header="_Window">
                <MenuItem Header="_New Window"/>
                <MenuItem Header="_Cascade"/>
                <MenuItem Header="Tile _Horizontally"/>
                <MenuItem Header="Tile _Vertically"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help Topics"/>
                <Separator/>
                <MenuItem Header="_About HybridAD-Manager"/>
            </MenuItem>
        </Menu>

        <!-- ToolBar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource ToolbarBackgroundBrush}">
        <ToolBar>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding NewUserCommand}"
                    ToolTip="New User">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="➕" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="New"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding FindCommand}"
                    ToolTip="Find (Ctrl+F)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Find"/>
                </StackPanel>
            </Button>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding DeleteCommand}"
                    ToolTip="Delete">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🗑" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Delete"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Refresh (F5)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding PropertiesCommand}"
                    ToolTip="Properties">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Properties"/>
                </StackPanel>
            </Button>
            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"/>
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding ExportCommand}"
                    ToolTip="Export to CSV">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊" FontSize="14" Margin="0,0,4,0"/>
                    <TextBlock Text="Export"/>
                </StackPanel>
            </Button>
        </ToolBar>
        <ToolBar Band="0" BandIndex="1">
            <Button Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding ToggleAuthenticationCommand}"
                    ToolTip="Sign in to Microsoft Entra ID">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AuthButtonText}"/>
                </StackPanel>
            </Button>
        </ToolBar>
        </ToolBarTray>

        <!-- Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}"/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ListViewModel.TotalCount, StringFormat='{}{0} objects'}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding DomainName}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding LoggedInUser}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Main Content: Tree + List Splitter -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180" MaxWidth="450"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Directory Tree -->
            <Border Grid.Column="0"
                    Background="{StaticResource PaneBackgroundBrush}"
                    BorderBrush="{StaticResource PaneBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                              Text="Directory"
                              FontWeight="SemiBold"
                              Padding="8,4"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,0,0,1"/>
                    <views:DirectoryTreeView DataContext="{Binding TreeViewModel}"/>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Width="4"
                          Background="{StaticResource SplitterBackground}"
                          ShowsPreview="False"/>

            <!-- Right Pane: Object List -->
            <Border Grid.Column="2"
                    Background="{StaticResource PaneBackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                              Text="Object List"
                              FontWeight="SemiBold"
                              Padding="8,4"
                              Background="{StaticResource ToolbarBackgroundBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,0,0,1"/>
                    <views:ObjectListView DataContext="{Binding ListViewModel}"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Border Background="#80000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="⏳"
                          FontSize="48"
                          HorizontalAlignment="Center"
                          Foreground="White"/>
                <TextBlock Text="{Binding BusyMessage}"
                          FontSize="14"
                          Foreground="White"
                          Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </DockPanel>
</Window>
